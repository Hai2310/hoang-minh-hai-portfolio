# Public canonical URL. Use the final Vercel/custom-domain URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public GitHub username used by both client and server rendering.
NEXT_PUBLIC_GITHUB_USERNAME=Hai2310
# Backward-compatible server-only alternative (NEXT_PUBLIC_GITHUB_USERNAME takes precedence).
GITHUB_USERNAME=Hai2310
# Optional server-only token; raises GitHub API rate limits. Never prefix this with NEXT_PUBLIC_.
GITHUB_TOKEN=

# Preferred contact provider: Resend.
RESEND_API_KEY=
# Must be a sender verified in Resend, for example Portfolio <portfolio@yourdomain.com>.
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=minhhaiit1k68@gmail.com

# Alternative contact provider. Keep server-only; do not prefix with NEXT_PUBLIC_.
FORMSPREE_ENDPOINT=

# Comma-separated production origins allowed to submit the contact form.
# NEXT_PUBLIC_SITE_URL is automatically allowed.
ALLOWED_ORIGINS=

# Optional shared rate limiting for multi-instance/serverless deployments.
# When absent, the app falls back to an in-memory limiter suitable for local or single-instance use.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
